# All relative paths resolve beneath the project root.
VG_BACKEND=demo
VG_WEIGHTS=models/ppe.pt
VG_DEVICE=cpu
VG_IMGSZ=320
VG_CONFIDENCE=0.40
VG_SAMPLE_FPS=4
VG_MIN_EVIDENCE_FRAMES=3
VG_MIN_EVIDENCE_SECONDS=0.5
VG_MAX_GAP_SECONDS=0.75
VG_MAX_VIDEO_SECONDS=300
VG_MAX_UPLOAD_MB=100
VG_MAX_PIXELS=16000000
# Leave empty for runtime/visualguard.db (SQLite).
VG_DATABASE_URL=
VG_API_URL=http://127.0.0.1:8000
